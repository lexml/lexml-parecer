{
  "compilerOptions": {
    "target": "es2021",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmitOnError": true,
    "lib": ["es2021", "dom", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "outDir": "dist",
    "sourceMap": true,
    "inlineSources": true,
    "rootDir": "./",
    "incremental": true,
    "skipLibCheck": true,
    "baseUrl": ".", 
    "paths": {
      "@ui-commons": [
        "./ui-commons/dist/index.d.ts",
        "./ui-commons/dist/index.js"
      ]
    }
  },
  "include": ["**/*.ts", "src/**/*", "src/types/**/*.d.ts"],
  "exclude": ["node_modules", "test"]
}
